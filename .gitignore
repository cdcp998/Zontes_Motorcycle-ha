# 本地私有资产: 调试工具与离线回归测试 (仅本地保留, 不参与版本控制/不上传)
tools/
tests/

# 逆向抓包 / 探测工作区 (含原始报文、密钥候选、临时脚本)
_probe/

# 现场诊断取证工作区 (HA 日志副本/recorder 查询/一次性探针脚本, 含隐私数据)
_diag/

# 诊断与抓包产物 (可能含真实会话/令牌)
*.pcap
*.bin

# Python 缓存与虚拟环境
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

