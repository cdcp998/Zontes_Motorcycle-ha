*.apk
*.dump
*.dmp
*.dex
*.hprof
*.jar
*.zip.tmp

# 本地敏感配置 (Home Assistant 等)
secrets.yaml
*.secrets.yaml
.env
.env.*

# 编辑器/IDE
.idea/
.vscode/
*.swp
